_# --- CONFIGURACIÓN DEL SERVIDOR ---
PORT=3000
NODE_ENV=development

# Clave secreta para firmar tokens de sesión y cifrado AES-256
# DEBE ser una cadena larga y aleatoria (e.g., generada con `openssl rand -hex 32`)
SERVER_SECRET=

# --- CONFIGURACIÓN DE GOOGLE OAUTH2 ---
# ID de Cliente de la aplicación web de Google Cloud
GOOGLE_CLIENT_ID=
# Secreto de Cliente de la aplicación web de Google Cloud
GOOGLE_CLIENT_SECRET=
# URL de redirección después de la autenticación (e.g., http://localhost:3000/auth/google/callback)
GOOGLE_REDIRECT_URI=

# --- CONFIGURACIÓN DE GEMINI API ---
# Clave de API para el acceso directo a Gemini (usada como fallback o para servicios específicos)
GEMINI_API_KEY=

# --- CONFIGURACIÓN DE REDIS ---
# URL de conexión a Redis (usado para la cola de trabajos y cache)
REDIS_URL=redis://localhost:6379_
